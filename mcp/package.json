{
  "name": "inisiasi-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "Local MCP server for inisiasi, which turns PLAN.md into a decided stack, architecture, first tasks, and the skills to install.",
  "type": "module",
  "files": [
    "dist",
    "catalog.json",
    "sot"
  ],
  "bin": {
    "inisiasi-mcp": "dist/server.js",
    "inisiasi": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "tsc && node -e \"require('node:fs').cpSync('../skill/inisiasi/references/sot','sot',{recursive:true})\"",
    "postpack": "node -e \"require('node:fs').rmSync('sot',{recursive:true,force:true})\"",
    "start": "node dist/server.js",
    "test": "npm run validate && npm run build && node test/docs.mjs && node test/stack.mjs && node test/drift.mjs && node test/catalog.mjs && node test/smoke.mjs",
    "validate": "node validate.mjs",
    "qa": "node test/qa.mjs",
    "check-catalog": "node check-catalog.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fuse.js": "^7.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.18.0"
}
